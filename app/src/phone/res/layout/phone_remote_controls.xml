<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/phone_remote_panel"
    android:orientation="vertical"
    android:padding="8dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="40dp"
        android:orientation="horizontal">

        <Button
            android:id="@+id/phone_focus_minus"
            style="@style/PhoneControlButton"
            android:text="对焦 −" />

        <Button
            android:id="@+id/phone_focus_plus"
            style="@style/PhoneControlButton"
            android:text="对焦 +" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="40dp"
        android:orientation="horizontal">

        <Button
            android:id="@+id/phone_distance_reset"
            style="@style/PhoneControlButton"
            android:onClick="onRemoteButtonClick"
            android:text="计米清零" />

        <Button
            android:id="@+id/phone_light"
            style="@style/PhoneControlButton"
            android:onClick="onRemoteButtonClick"
            android:text="补光灯" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="36dp"
        android:orientation="horizontal">

        <Button
            android:id="@+id/phone_menu"
            style="@style/PhoneControlButton"
            android:onClick="onRemoteButtonClick"
            android:text="MENU" />

        <Button
            android:id="@+id/phone_back"
            style="@style/PhoneControlButton"
            android:text="返回/麦克风" />

        <Button
            android:id="@+id/phone_rotate"
            style="@style/PhoneControlButton"
            android:onClick="onRemoteButtonClick"
            android:text="旋转 ↻" />
    </LinearLayout>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:foregroundGravity="center">

        <FrameLayout
            android:layout_width="180dp"
            android:layout_height="180dp"
            android:layout_gravity="center"
            android:background="@drawable/phone_direction_ring">

            <Button
                android:id="@+id/phone_up"
                style="@style/PhoneDirectionButton"
                android:layout_width="88dp"
                android:layout_height="52dp"
                android:layout_gravity="top|center_horizontal"
                android:text="▲" />

            <Button
                android:id="@+id/phone_left"
                style="@style/PhoneDirectionButton"
                android:layout_width="52dp"
                android:layout_height="88dp"
                android:layout_gravity="center_vertical|left"
                android:text="◀" />

            <Button
                android:id="@+id/phone_right"
                style="@style/PhoneDirectionButton"
                android:layout_width="52dp"
                android:layout_height="88dp"
                android:layout_gravity="center_vertical|right"
                android:text="▶" />

            <Button
                android:id="@+id/phone_down"
                style="@style/PhoneDirectionButton"
                android:layout_width="88dp"
                android:layout_height="52dp"
                android:layout_gravity="bottom|center_horizontal"
                android:text="▼" />

            <Button
                android:id="@+id/phone_ok_home"
                style="@style/PhoneDirectionCenterButton"
                android:layout_width="76dp"
                android:layout_height="76dp"
                android:layout_gravity="center"
                android:text="OK / HOME"
                android:textSize="10sp" />
        </FrameLayout>
    </FrameLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:orientation="horizontal">

        <Button
            android:id="@+id/phone_photo"
            style="@style/PhoneControlButton"
            android:onClick="onRemoteButtonClick"
            android:text="📷 拍照" />

        <Button
            android:id="@+id/phone_record"
            style="@style/PhoneControlButton"
            android:onClick="onRemoteButtonClick"
            android:text="● REC" />
    </LinearLayout>
</LinearLayout>
