<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#091722"
    android:orientation="vertical"
    android:paddingStart="14dp"
    android:paddingTop="12dp"
    android:paddingEnd="14dp"
    android:paddingBottom="12dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="94dp"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="AHD  遥控台"
                android:textColor="#F3FBFF"
                android:textSize="21sp"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/phone_board_ip"
                android:layout_width="152dp"
                android:layout_height="40dp"
                android:background="@drawable/phone_ip_field"
                android:hint="主板 IP"
                android:inputType="textUri"
                android:paddingStart="12dp"
                android:paddingEnd="10dp"
                android:singleLine="true"
                android:textColor="#E9F8FF"
                android:textColorHint="#819DAD"
                android:textSize="14sp" />

        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="46dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <Button
                android:id="@+id/phone_discover"
                style="@style/PhoneHeaderButton"
                android:layout_width="0dp"
                android:layout_height="42dp"
                android:layout_weight="1"
                android:text="搜索" />

            <Button
                android:id="@+id/phone_connect"
                style="@style/PhonePrimaryButton"
                android:layout_width="76dp"
                android:layout_height="42dp"
                android:layout_weight="0"
                android:text="连接" />

            <Button
                android:id="@+id/phone_disconnect"
                style="@style/PhoneHeaderButton"
                android:layout_width="76dp"
                android:layout_height="42dp"
                android:text="断开" />
        </LinearLayout>
    </LinearLayout>

    <TextView
        android:id="@+id/phone_connection_status"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:gravity="center_vertical"
        android:paddingStart="8dp"
        android:scrollbars="vertical"
        android:text="与主板连接同一个 Wi-Fi，输入主板 IP"
        android:textColor="#95BDCB"
        android:textSize="13sp" />

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginBottom="10dp"
        android:background="@drawable/phone_preview_frame"
        android:padding="2dp">

        <TextureView
            android:id="@+id/phone_preview"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />
    </FrameLayout>

    <include
        layout="@layout/phone_remote_controls"
        android:layout_width="match_parent"
        android:layout_height="354dp" />
</LinearLayout>
