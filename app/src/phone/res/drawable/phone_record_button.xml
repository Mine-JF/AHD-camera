<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true" android:drawable="@drawable/phone_control_button" />
    <item android:state_selected="true">
        <shape>
            <solid android:color="#AC3545" />
            <corners android:radius="12dp" />
            <stroke android:width="2dp" android:color="#FF9EA9" />
        </shape>
    </item>
    <item android:drawable="@drawable/phone_control_button" />
</selector>
