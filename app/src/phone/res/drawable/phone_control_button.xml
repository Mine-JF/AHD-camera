<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape>
            <solid android:color="#315B72" />
            <corners android:radius="14dp" />
            <stroke android:width="1dp" android:color="#8BE7E6" />
        </shape>
    </item>
    <item>
        <shape>
            <solid android:color="#20364A" />
            <corners android:radius="14dp" />
            <stroke android:width="1dp" android:color="#345166" />
        </shape>
    </item>
</selector>
