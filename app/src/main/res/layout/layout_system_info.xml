<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_settings_card"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tv_sdk_info"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="18dp"
            android:text="@string/settings_sdk_version"
            android:textColor="@color/settings_text_primary"
            android:textSize="18sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/settings_border" />

        <TextView
            android:id="@+id/tv_screen_info"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="18dp"
            android:text="@string/settings_screen_info"
            android:textColor="@color/settings_text_primary"
            android:textSize="18sp" />
    </LinearLayout>
</LinearLayout>
