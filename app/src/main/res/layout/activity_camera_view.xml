<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000"
    tools:context=".Camera_view">

    <LinearLayout
        android:id="@+id/camera_container"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="horizontal">

        <FrameLayout
            android:id="@+id/left_camera_container"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="#000000">

            <TextureView
                android:id="@+id/left_camera_preview"
                android:layout_width="match_parent"
                android:layout_height="match_parent" />
        </FrameLayout>

        <FrameLayout
            android:id="@+id/right_camera_container"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="#000000"
            android:visibility="gone">

            <TextureView
                android:id="@+id/right_camera_preview"
                android:layout_width="match_parent"
                android:layout_height="match_parent" />
        </FrameLayout>
    </LinearLayout>

    <TextView
        android:id="@+id/status_text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:text="@string/camera_loading"
        android:textColor="#FFFFFF"
        android:textSize="18sp"
        android:visibility="gone" />

    <FrameLayout
        android:id="@+id/camera_hud"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_gravity="top"
        android:clickable="false"
        android:focusable="false">

        <LinearLayout
            android:id="@+id/camera_hud_top_bar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="top"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="20dp"
            android:paddingTop="14dp"
            android:paddingEnd="20dp"
            android:paddingBottom="8dp">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center_vertical"
                android:orientation="horizontal">

            <TextView
                android:id="@+id/hud_datetime"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:shadowColor="#99000000"
                android:shadowDx="0"
                android:shadowDy="1"
                android:shadowRadius="3"
                android:text="@string/camera_hud_datetime_placeholder"
                android:textColor="#F2F2F2"
                android:textSize="28sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/hud_distance"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="28dp"
                android:shadowColor="#99000000"
                android:shadowDx="0"
                android:shadowDy="1"
                android:shadowRadius="3"
                android:text="@string/camera_hud_distance_placeholder"
                android:textColor="#F2F2F2"
                android:textSize="28sp"
                android:textStyle="bold" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/hud_status_group"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

            <FrameLayout
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:layout_marginStart="12dp"
                android:foregroundGravity="top|right">

                <ImageView
                    android:id="@+id/hud_mic_icon"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:layout_gravity="center"
                    android:contentDescription="@string/camera_hud_mic"
                    android:src="@drawable/ic_hud_mic"
                    android:tint="#F7F7F7" />

                <ImageView
                    android:id="@+id/hud_mic_off_badge"
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:layout_gravity="top|end"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_hud_status_x"
                    android:visibility="gone" />
            </FrameLayout>

            <ImageView
                android:id="@+id/hud_wifi_icon"
                android:layout_width="44dp"
                android:layout_height="36dp"
                android:layout_marginStart="12dp"
                android:contentDescription="@string/camera_hud_wifi"
                android:src="@drawable/ic_hud_wifi_4" />

            <FrameLayout
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:layout_marginStart="12dp"
                android:foregroundGravity="top|right">

                <ImageView
                    android:id="@+id/hud_storage_icon"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:layout_gravity="center"
                    android:contentDescription="@string/camera_hud_storage"
                    android:src="@drawable/ic_hud_storage"
                    android:tint="#F7F7F7" />

                <ImageView
                    android:id="@+id/hud_storage_off_badge"
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:layout_gravity="top|end"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_hud_status_x"
                    android:visibility="gone" />
            </FrameLayout>

            <ImageView
                android:id="@+id/hud_battery_icon"
                android:layout_width="48dp"
                android:layout_height="36dp"
                android:layout_marginStart="12dp"
                android:contentDescription="@string/camera_hud_battery"
                android:src="@drawable/ic_hud_battery"
                android:tint="#F7F7F7" />

            <TextView
                android:id="@+id/hud_battery_status"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:shadowColor="#99000000"
                android:shadowDx="0"
                android:shadowDy="1"
                android:shadowRadius="3"
                android:text="@string/camera_hud_battery"
                android:textColor="#F7F7F7"
                android:textSize="24sp"
                android:textStyle="bold" />
            </LinearLayout>
        </LinearLayout>

        <TextView
            android:id="@+id/recording_subtitle"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_gravity="top|start"
            android:layout_marginStart="48dp"
            android:layout_marginEnd="48dp"
            android:layout_marginTop="76dp"
            android:layout_marginBottom="20dp"
            android:gravity="top|start"
            android:padding="0dp"
            android:shadowColor="#FF000000"
            android:shadowDx="1"
            android:shadowDy="1"
            android:shadowRadius="2"
            android:textColor="#FFFFFFFF"
            android:textSize="24sp"
            android:visibility="gone" />
    </FrameLayout>

</FrameLayout>
