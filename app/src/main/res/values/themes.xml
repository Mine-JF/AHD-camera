<resources xmlns:tools="http://schemas.android.com/tools">

    <style name="Theme.AHD_Camera" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <item name="colorPrimary">@color/purple_500</item>
        <item name="colorPrimaryVariant">@color/purple_700</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorSecondary">@color/teal_200</item>
        <item name="colorSecondaryVariant">@color/teal_700</item>
        <item name="colorOnSecondary">@color/black</item>
        <item name="windowNoTitle">true</item>
        <item name="windowActionBar">false</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowActionBar">false</item>
        <item name="android:windowFullscreen">true</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLayoutInDisplayCutoutMode" tools:targetApi="o_mr1">shortEdges</item>
    </style>

    <style name="SettingsOptionButton">
        <item name="android:layout_width">170dp</item>
        <item name="android:layout_height">48dp</item>
        <item name="android:background">@drawable/bg_settings_button_selector</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textColor">@color/settings_button_text_selector</item>
        <item name="android:textSize">20sp</item>
    </style>

    <style name="SettingsOptionButton.Small" parent="SettingsOptionButton">
        <item name="android:layout_width">120dp</item>
        <item name="android:layout_height">42dp</item>
        <item name="android:textSize">22sp</item>
    </style>

    <style name="SettingsOptionButton.Large" parent="SettingsOptionButton">
        <item name="android:layout_width">230dp</item>
        <item name="android:layout_height">66dp</item>
        <item name="android:textSize">24sp</item>
    </style>

</resources>
