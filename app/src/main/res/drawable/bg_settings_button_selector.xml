<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_enabled="false">
        <shape>
            <solid android:color="@color/settings_button_disabled_fill" />
            <corners android:radius="12dp" />
            <stroke
                android:width="1dp"
                android:color="@color/settings_button_disabled_stroke" />
        </shape>
    </item>
    <item android:state_selected="true">
        <shape>
            <solid android:color="@color/settings_button_selected_fill" />
            <corners android:radius="12dp" />
            <stroke
                android:width="3dp"
                android:color="@color/settings_button_selected_stroke" />
        </shape>
    </item>
    <item android:state_pressed="true">
        <shape>
            <solid android:color="@color/settings_button_selected_fill" />
            <corners android:radius="12dp" />
            <stroke
                android:width="3dp"
                android:color="@color/settings_button_selected_stroke" />
        </shape>
    </item>
    <item>
        <shape>
            <solid android:color="@color/settings_button_default_fill" />
            <corners android:radius="12dp" />
            <stroke
                android:width="1dp"
                android:color="@color/settings_button_default_stroke" />
        </shape>
    </item>
</selector>
