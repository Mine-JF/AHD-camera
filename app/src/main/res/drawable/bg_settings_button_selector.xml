<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_selected="true">
        <shape>
            <gradient
                android:angle="90"
                android:endColor="@color/settings_button_default_bottom"
                android:startColor="@color/settings_button_default_top" />
            <corners android:radius="12dp" />
            <stroke
                android:width="1dp"
                android:color="@color/settings_button_default_stroke" />
        </shape>
    </item>
    <item android:state_pressed="true">
        <shape>
            <gradient
                android:angle="90"
                android:endColor="@color/settings_button_default_bottom"
                android:startColor="@color/settings_button_default_top" />
            <corners android:radius="12dp" />
            <stroke
                android:width="1dp"
                android:color="@color/settings_button_default_stroke" />
        </shape>
    </item>
    <item>
        <shape>
            <gradient
                android:angle="90"
                android:endColor="@color/settings_button_default_bottom"
                android:startColor="@color/settings_button_default_top" />
            <corners android:radius="12dp" />
            <stroke
                android:width="1dp"
                android:color="@color/settings_button_default_stroke" />
        </shape>
    </item>
</selector>
