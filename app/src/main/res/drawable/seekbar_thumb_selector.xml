<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <layer-list>
            <item
                android:width="28dp"
                android:height="28dp">
                <shape android:shape="oval">
                    <solid android:color="@color/white" />
                </shape>
            </item>
            <item
                android:left="4dp"
                android:top="4dp"
                android:right="4dp"
                android:bottom="4dp">
                <shape android:shape="oval">
                    <solid android:color="@color/settings_accent_dark" />
                </shape>
            </item>
        </layer-list>
    </item>
    <item android:state_pressed="true">
        <layer-list>
            <item
                android:width="24dp"
                android:height="24dp">
                <shape android:shape="oval">
                    <solid android:color="@color/white" />
                </shape>
            </item>
            <item
                android:left="4dp"
                android:top="4dp"
                android:right="4dp"
                android:bottom="4dp">
                <shape android:shape="oval">
                    <solid android:color="@color/settings_accent_dark" />
                </shape>
            </item>
        </layer-list>
    </item>
    <item>
        <shape android:shape="oval">
            <size
                android:width="20dp"
                android:height="20dp" />
            <solid android:color="@color/settings_slider_fill" />
        </shape>
    </item>
</selector>
